# Copy to `.env` for local development, and use as the checklist when filling in
# Vercel's Environment Variables. Every value here is a placeholder — no real
# secret belongs in this file, which is the only env file that is committed.

# --- Database -----------------------------------------------------------------
# Neon connection string. Use a separate branch/database for preview deployments
# if you don't want them writing into production data.
PG_CONNECTION_STRING=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Auth ---------------------------------------------------------------------
# Any long random string; `openssl rand -base64 32`. A different value per
# environment is fine — changing it invalidates existing sessions.
BETTER_AUTH_SECRET=replace-me

# Where this app lives. See lib/server/origin.ts.
#
#   Local:   http://localhost:3000
#   Vercel:  LEAVE UNSET. appOrigin() derives it from VERCEL_PROJECT_PRODUCTION_URL
#            (production) or VERCEL_URL (previews), so a preview points at itself
#            instead of sending buyers and auth callbacks to production.
#            Set it only to pin a custom domain, e.g. https://creator-commerce.com
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe -------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Local: the whsec_… printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Deployed: a DIFFERENT secret, from the dashboard endpoint you create. That
# endpoint must subscribe to checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded and checkout.session.async_payment_failed
# — the four app/api/stripe/webhook/route.ts switches on. Dropping `expired`
# silently disables abandoned-checkout cleanup.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Uploads ------------------------------------------------------------------
# From the UploadThing dashboard. Base64 JSON; lib/server/uploadthing.ts decodes
# `appId` out of it. Note next.config.ts pins images.remotePatterns to one appId,
# so pointing at a different UploadThing project needs that updated too.
UPLOADTHING_TOKEN=...

# --- Cron ---------------------------------------------------------------------
# Gates /api/cron/expire-orders. Vercel Cron sends it as `Authorization: Bearer …`.
# Generate a real random value for production — the route is public otherwise.
CRON_SECRET=replace-me

# --- Email --------------------------------------------------------------------
# Gmail + a 16-character App Password (Google Account → Security → 2-Step
# Verification → App passwords). With GMAIL_APP_PASSWORD unset, mail is printed
# to the terminal instead of sent.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Optional display name; Gmail rewrites the address to GMAIL_USER regardless.
EMAIL_FROM="Creator Commerce <you@gmail.com>"
# Set to `console` to force terminal output even with a password present.
# EMAIL_TRANSPORT=console

# --- Analytics ----------------------------------------------------------------
# Both are public by design: a PostHog project API key is write-only and ships in
# the browser bundle. The server half (lib/server/analytics.ts) reuses the same
# key on purpose. No personal/secret PostHog key is needed — the app only sends
# events, it never reads from the API. Unset, analytics degrades to console.info.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Optional -----------------------------------------------------------------
# Set to 1 to log every Drizzle query.
# DB_LOG=1
