# better-auth declares `peerOptional drizzle-kit ">=0.31.4"`, and this project is
# on drizzle-kit 1.0.0-rc.4. A prerelease does not satisfy a plain semver range —
# `1.0.0-rc.4` is excluded from `>=0.31.4` because the range names no prerelease
# for that version — so npm tries to resolve a second, older drizzle-kit beside
# it and fails with ERESOLVE.
#
# This is why `npm install` works on a machine whose node_modules predates the
# conflict and fails on a clean checkout: Vercel's build ran `npm install` from
# empty and exited 1. Setting it here rather than in the Vercel dashboard's
# install command keeps local, CI and deploy resolving identically, and keeps the
# reason in the repo.
#
# Safe because the peer is *optional* and only used by better-auth's schema-
# generation CLI, which this project does not run — migrations come from
# drizzle-kit directly (`npm run db:generate`). Revisit when drizzle-kit 1.0
# leaves rc and better-auth widens the range.
legacy-peer-deps=true
